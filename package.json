{
  "name": "kami-dsh",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/check-bundle.mjs",
    "dev": "node --test --watch tests/sqlite-store.test.mjs tests/dsh-policy.test.mjs tests/dsh-workbench.test.mjs",
    "test": "node --import ./tests/setup-env.mjs --test",
    "directus:up": "docker compose --env-file directus/.env -f directus/docker-compose.yml up -d",
    "directus:down": "docker compose --env-file directus/.env -f directus/docker-compose.yml down",
    "directus:provision": "node --env-file=directus/.env scripts/provision-directus.mjs",
    "directus:backfill-memory-hash": "node --env-file=directus/.env scripts/backfill-memory-hash.mjs",
    "directus:dedupe-memory": "node --env-file=directus/.env scripts/dedupe-memory.mjs",
    "directus:prune-history": "node --env-file=directus/.env scripts/prune-directus-revisions.mjs",
    "taxonomy:migrate": "node --env-file=directus/.env scripts/migrate-content-taxonomy.mjs",
    "directus:drop-shares": "node --env-file=directus/.env scripts/cleanup-shares-collection.mjs",
    "directus:snapshot": "docker compose --env-file directus/.env -f directus/docker-compose.yml exec -T directus node /directus/cli.js schema snapshot --yes /directus/schema/snapshot.yaml",
    "dsh:check": "node scripts/check-bundle.mjs",
    "migrate:local": "node scripts/migrate-local.mjs"
  },
  "engines": {
    "node": ">=24.2",
    "dsh": "0.2.1-rc.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289",
    "saxes": "5.0.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "description": "Local Japanese-to-Simplified-Chinese translation workbench for DeepSeek Harness",
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./agent": "./dsh/agent.mjs",
    "./client": "./dsh/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./dsh/icon.svg",
    "./agent/locale/*.json": "./locale/*.json",
    "./agent/icon": "./dsh/icon.svg"
  },
  "files": [
    "dsh/",
    "src/",
    "public/batch-status.js",
    "server.mjs",
    "cordis.patch.yml",
    "locale/",
    "scripts/migrate-local.mjs",
    "docs/DSH.md",
    "scripts/check-bundle.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoxinblast/kami-dsh.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  }
}
